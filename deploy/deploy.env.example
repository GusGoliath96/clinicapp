# Configuração do deploy da VM. Copie para /etc/clinica-deploy.env e preencha.
#
#   sudo cp deploy.env.example /etc/clinica-deploy.env
#   sudo chmod 600 /etc/clinica-deploy.env     # tem o token do DuckDNS
#
# Lido pelo Caddy (substituição {$VAR} no Caddyfile) e pelo timer do DuckDNS.

# O nome que você criou no duckdns.org, SEM o ".duckdns.org".
DUCKDNS_SUBDOMINIO=SEUNOME

# Token da conta (aparece no topo do painel do duckdns.org). É a senha do seu DNS.
DUCKDNS_TOKEN=cole-o-token-aqui

# Domínio base dos três subdomínios servidos pelo Caddy. Quando comprar o domínio da
# clínica, é ESTA linha que muda — mais nada.
DOMINIO_BASE=SEUNOME.duckdns.org

# E-mail para o Let's Encrypt (avisos de expiração de certificado).
ACME_EMAIL=voce@exemplo.com

# Onde o motor de IA está clonado na VM. O ClinicaApp não precisa de variável: os scripts
# de deploy se localizam sozinhos a partir da própria pasta deploy/.
AI_AGENT_DIR=/home/gus/Documentos/ai_agent
