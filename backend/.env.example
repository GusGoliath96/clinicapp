# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Endereço do SPA. Entra no link de redefinição de senha enviado por e-mail.
APP_URL=http://localhost:5173

# Banco (bate com docker-compose.yml)
DATABASE_URL=postgres://clinicapp:clinicapp@localhost:5432/clinicapp

# Auth
# Em produção (NODE_ENV=production) o servidor se recusa a subir sem JWT_SECRET.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d
# bcryptjs bloqueia o event loop enquanto calcula; cada +1 dobra esse tempo.
BCRYPT_COST=11

# Segundo fator por e-mail (on | off). Só ligue depois que `npm run mail:teste` entregar
# de verdade — com isto ligado e o e-mail fora do ar, ninguém entra.
TWO_FACTOR=off

# E-mail transacional (Resend). Sem a chave, o código/link é impresso no console do
# servidor em vez de enviado — suficiente para desenvolver, inútil em produção.
RESEND_API_KEY=
# onboarding@resend.dev dispensa verificar domínio, mas só entrega no e-mail dono da conta.
MAIL_FROM=ClinicaApp <onboarding@resend.dev>

# Primeiro acesso criado pelo `npm run db:setup`. Sem isto, nenhum usuário é criado
# (use `npm run auth:admin -- <email>`). A senha é impressa uma única vez.
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=

# Motor de IA / WhatsApp (ai_agent) — todo o WhatsApp passa por ele.
# Base do motor e a API key do tenant (aparece 1x ao rodar o seed-clinica do motor).
AI_ENGINE_URL=http://localhost:4000
AI_ENGINE_API_KEY=
# Segredo que valida a assinatura dos callbacks do motor (X-Signature-256).
AI_ENGINE_SIGNING_SECRET=
# Token de serviço que o motor apresenta p/ chamar /patients e /appointments (tools do fluxo).
# Precisa ser IGUAL ao CLINICA_SERVICE_TOKEN configurado no motor.
SERVICE_API_KEY=
