# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Banco (bate com docker-compose.yml)
DATABASE_URL=postgres://clinicapp:clinicapp@localhost:5432/clinicapp

# Auth
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# Motor de IA / WhatsApp (ai_agent) — todo o WhatsApp passa por ele.
# Base do motor e a API key do tenant (aparece 1x ao rodar o seed-clinica do motor).
AI_ENGINE_URL=http://localhost:4000
AI_ENGINE_API_KEY=
# Segredo que valida a assinatura dos callbacks do motor (X-Signature-256).
AI_ENGINE_SIGNING_SECRET=
# Token de serviço que o motor apresenta p/ chamar /patients e /appointments (tools do fluxo).
# Precisa ser IGUAL ao CLINICA_SERVICE_TOKEN configurado no motor.
SERVICE_API_KEY=
